# Скопируйте в `.env` и подставьте значения.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/note
JWT_SECRET_KEY=смените-на-длинную-случайную-строку

# Разрешённые origin для браузера (UI на http://localhost:8080, как на VPS)
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Редко нужно отключить авто-применение миграций при старте API (pytest выставляет сам).
# SKIP_ALEMBIC_AT_STARTUP=1

# Локальные вложения (Docker Compose монтирует том в /app/data/attachments)
# ATTACHMENTS_DIR=/app/data/attachments
# MAX_ATTACHMENT_BYTES=26214400

# Распознавание аудио (Vosk): в Docker-образе API модель уже в /opt/vosk-model/... (см. Dockerfile).
# Только локальный запуск без Docker — скачайте модель и укажите путь:
# VOSK_MODEL_PATH=/absolute/path/to/vosk-model-small-ru-0.22
# Docker (docker-compose): FFMPEG_PATH задаётся в compose, обычно не нужен в .env
# Локально на Windows без Docker — полный путь или оставьте пустым (тогда imageio-ffmpeg)
# FFMPEG_PATH=C:\Program Files\Gyan\FFmpeg\bin\ffmpeg.exe

# ── Общая отправка почты («Поделиться заметкой по email»), если у пользователя не задан SMTP в аккаунте.
# Настройка почтовых клиентов Timeweb: https://timeweb.com/ru/docs/pochta/nastrojka-pochtovyh-klientov/
# Часто: сервер smtp.timeweb.ru, порт 465 (SSL с начала соединения), логин = полный email ящика.
# Пароль только здесь или в секретах оркестратора — не коммитьте в git.
#
# SMTP_RELAY_HOST=smtp.timeweb.ru
# SMTP_RELAY_PORT=465
# SMTP_RELAY_USERNAME=info@example.ru
# Пароль ящика (не коммитьте в git). Либо только файл:
# SMTP_RELAY_PASSWORD_FILE=/run/secrets/smtp_relay_password
# SMTP_RELAY_PASSWORD=
# SMTP_RELAY_FROM_ADDRESS=info@example.ru
# SMTP_RELAY_TLS_IMMEDIATE=true
# SMTP_RELAY_START_TLS=false
#
# Альтернатива — порт 587 + STARTTLS:
# SMTP_RELAY_PORT=587
# SMTP_RELAY_TLS_IMMEDIATE=false
# SMTP_RELAY_START_TLS=true
