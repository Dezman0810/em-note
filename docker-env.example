# Переименуйте в `.env` в корне репозитория (рядом с docker-compose.yml).
# Docker Compose автоматически подставляет эти переменные при сборке и запуске.
#
# Рекомендация для нестабильной сети / Windows при ошибке сборки образа api (curl: (18) transfer closed...) —
# сборка образа без скачивания модели Vosk (~50 MB). Голос в заметках тогда недоступен, пока не скачаете модель вручную.
SKIP_VOSK_DOWNLOAD=1
VOSK_MODEL_PATH=
