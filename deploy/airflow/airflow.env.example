# Скопируйте: cp deploy/airflow/airflow.env.example deploy/airflow/airflow.env

# Обязательно: ключ шифрования (своей сгенерируйте: openssl rand -base64 32)
AIRFLOW_FERNET_KEY=lUfA4L1eqg+fsl/TV11oMNeGf7ohYQRy+7Ii7bb5S4U=

# Один и тот же во всех сервисах Airflow этого compose (иначе при открытии логов в UI — 403).
# Свой ключ: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=PASTE_64_HEX_CHARS_HERE

# Вход в веб UI Airflow
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Подключение к Postgres em-note на машине-хосте (компорт 5432 должен быть открыт).
# Если пароль БД другой — поправьте здесь URI.
AIRFLOW_CONN_POSTGRES_EM_NOTE=postgresql://postgres:postgres@host.docker.internal:5432/note

# Именованный том с вложениями (docker volume ls | Select-String attachments).
# Обычно em-note_em_note_attachments при docker compose из каталога проекта em-note.
EM_NOTE_ATTACHMENTS_VOLUME=em-note_em_note_attachments

# --- Dropbox API (обязательно для DAG em_note_db_backup). Подробно: DROPBOX-STEPS-RU.txt ---
#
# Приложение: https://www.dropbox.com/developers/apps
#
# Тип «App folder»: в Dropbox API корень уже ваша Apps/<имя> — здесь ставьте / или подпапку /daily и т.д.
# Полный аккаунт «Full Dropbox»: любой каталог, напр. /em-note-backups
# Scope: files.content.write. В консоли на вкладке Permissions после выбора — Submit.
#
# Способ А (рекомендовано для VPS): refresh + ключ приложения.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Способ Б (быстро локально): один «Generated access token» в консоли приложения; refresh/key/secret не нужны.
DROPBOX_ACCESS_TOKEN=

# По умолчанию "/": типично для приложения только с «App folder». Full Dropbox → /em-note-backups или свой путь.
DROPBOX_REMOTE_ROOT=/

# --- Восстановление (DAG em_note_restore_from_dropbox, ручной запуск) ---
# Либо три поля в форме Trigger DAG, либо здесь / Variables:
# EM_NOTE_RESTORE_BACKUP_DATE=2026-05-10
# EM_NOTE_RESTORE_NOTE_SQL=note_20260510_225145.sql
# EM_NOTE_RESTORE_ATTACHMENTS_TAR=attachments_20260510_225145.tar.gz
# Том вложений перед распаковкой всегда очищается (полное восстановление).
# После правок: docker compose -f docker-compose.airflow.yml up -d --force-recreate
